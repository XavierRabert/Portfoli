---
interface Props {
  data: any;
}
const { data } = Astro.props;
const main = data.main;
import Social from "./common/Social.astro";
import Header from "./Header.astro";
---

<section id="main" class="relative min-h-screen overflow-hidden">
  <div
    class="absolute inset-0 bg-[radial-gradient(circle_at_20%_30%,_rgba(255,136,61,0.23),_transparent_36%),_radial-gradient(circle_at_80%_20%,_rgba(58,143,242,0.20),_transparent_55%)]"
  >
  </div>
  <div
    class="absolute inset-0 bg-gradient-to-b from-slate-950/80 via-slate-900/80 to-slate-900"
  >
  </div>
  <Header data={data} />

  <div
    class="relative z-10 mx-auto flex min-h-[calc(100vh-72px)] max-w-6xl items-start md:items-center px-4 py-12 lg:px-12"
  >
    <div
      class="glass-card rounded-3xl border border-slate-600/40 bg-slate-900/60 p-8 shadow-2xl backdrop-blur-lg w-full"
    >
      <div>
        <h2 class="text-3xl md:text-5xl font-bold text-orange-400 mb-2">
          {main.imgName}
        </h2>
        <h1 class="text-4xl md:text-6xl text-slate-100 font-extrabold mb-4">
          {main.title}
        </h1>
        <p class="text-lg text-slate-200 mb-3" set:html={main.text1} />
        <p class="text-lg text-slate-200 mb-5">{main.text2}</p>
        <div class="flex gap-3 flex-wrap">
          <a
            href="#projects"
            class="rounded-lg bg-gradient-to-r from-blue-500 to-cyan-500 px-5 py-2.5 text-sm font-semibold text-white transition hover:brightness-110"
          >
            Veure projectes
          </a>
          <a
            href="#about"
            class="rounded-lg border border-slate-600 px-5 py-2.5 text-sm font-medium text-slate-100 transition hover:bg-slate-800"
          >
            Sobre mi
          </a>
        </div>
      </div>
      <div class="mt-6">
        <Social />
      </div>
    </div>
  </div>
</section>
