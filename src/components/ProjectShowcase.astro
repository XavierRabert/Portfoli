---
const projects = [
  {
    number: "01",
    name: "Arcana",
    eyebrow: "Producte personal · Desenvolupament pausat",
    description:
      "Una aplicació completa per gestionar col·leccions i maços Commander de Magic: The Gathering. Inclou inventari de cartes, wishlist, sincronització, anàlisi de maços i una interfície pròpia.",
    stack: ["Angular 21", "TypeScript", "Signals", "Tailwind CSS 4", "Supabase", "Scryfall"],
    kind: "arcana",
    href: "https://arcana.xavierrabert.com",
  },
  {
    number: "02",
    name: "SEO amb Talons",
    eyebrow: "Web professional · Publicada",
    description:
      "Desenvolupament de la web de la consultoria SEO de Laia Xarau. M'he encarregat de construir el producte web i les seves integracions, amb una arquitectura basada en Astro i contingut gestionat amb Sanity.",
    stack: ["Astro 6", "Tailwind CSS 4", "React", "Sanity"],
    kind: "seo",
    href: "https://www.seoambtalons.cat",
  },
];
---

<section id="projects" class="project-showcase" aria-labelledby="projects-title">
  <div class="project-heading">
    <div>
      <p class="redesign-kicker">Projectes seleccionats</p>
      <h2 id="projects-title">Idees que es<br /><em>converteixen en producte.</em></h2>
    </div>
    <p class="project-heading-copy">
      Projectes propis i col·laboracions on el desenvolupament, el criteri tècnic
      i l'experiència d'usuari van de la mà.
    </p>
  </div>

  <div class="project-grid">
    {projects.map((project) => (
      <article class:list={["project-card", `project-card--${project.kind}`]}>
        <div class="project-visual">
          {project.kind === "seo" ? (
            <div class="seo-art" aria-label="Identitat visual de SEO amb Talons">
              <div class="seo-art-top">
                <span>WEB PROJECT</span>
                <span>02 / 02</span>
              </div>
              <div class="seo-brand">
                <div class="seo-mark" aria-hidden="true">
                  <span class="seo-mark-ring"></span>
                  <span class="seo-mark-dot"></span>
                  <span class="seo-mark-line"></span>
                </div>
                <span class="seo-word">SEO <i>AMB</i> TALONS</span>
                <span class="seo-caption">ESTRATÈGIA · VISIBILITAT · CREIXEMENT</span>
              </div>
              <div class="seo-art-bottom">
                <span>ESTRATÈGIA</span>
                <span>CONTINGUT</span>
                <span>POSICIONAMENT</span>
              </div>
            </div>
          ) : (
            <div class="arcana-art" aria-label="Identitat visual del projecte Arcana">
              <div class="arcana-art-top">
                <span>PERSONAL PROJECT</span>
                <span>01 / 02</span>
              </div>
              <div class="arcana-brand">
                <img
                  src="https://arcana.xavierrabert.com/assets/arcana-mark.svg"
                  alt="Símbol d'Arcana"
                  width="76"
                  height="76"
                  loading="lazy"
                />
                <span class="arcana-word">MTG ARCANA</span>
                <span class="arcana-caption">COMMANDER COMPANION</span>
              </div>
              <div class="arcana-art-bottom">
                <span>DECKS</span>
                <span>COLLECTION</span>
                <span>DECK ADVISOR</span>
              </div>
            </div>
          )}
          <span class="project-number">{project.number}</span>
        </div>

        <div class="project-content">
          <p class="project-eyebrow">{project.eyebrow}</p>
          <h3>{project.name}</h3>
          <p class="project-description">{project.description}</p>
          <ul class="project-stack" aria-label="Tecnologies">
            {project.stack.map((technology) => <li>{technology}</li>)}
          </ul>
          {project.href && (
            <a
              class="project-link"
              href={project.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              Visitar el projecte <span aria-hidden="true">↗</span>
            </a>
          )}
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .project-showcase {
    padding-block: 88px 104px;
    border-top: 1px solid var(--color-border);
  }

  .project-heading {
    display: grid;
    grid-template-columns: 1fr .8fr;
    gap: 60px;
    align-items: end;
    margin-bottom: 38px;
  }

  .project-heading h2 {
    margin: 18px 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.7rem, 5vw, 4.2rem);
    letter-spacing: -.075em;
    line-height: 1.04;
  }

  .project-heading h2 em {
    color: var(--color-accent);
    font-style: normal;
  }

  .project-heading-copy {
    max-width: 460px;
    margin: 0 0 5px;
    color: var(--color-muted);
    font-size: .96rem;
    line-height: 1.8;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .project-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: var(--color-surface);
  }

  .project-visual {
    position: relative;
    height: clamp(220px, 27vw, 340px);
    overflow: hidden;
    background: #171c1c;
  }

  .project-visual > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 500ms ease;
  }

  .project-card:hover .project-visual > img {
    transform: scale(1.035);
  }

  .project-number {
    position: absolute;
    top: 16px;
    right: 16px;
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border: 1px solid rgba(240, 240, 236, .24);
    border-radius: 50%;
    background: rgba(17, 19, 21, .72);
    color: var(--color-text);
    font-size: .68rem;
    backdrop-filter: blur(8px);
  }

  .seo-art {
    --seo-accent: #e7a0a9;
    position: relative;
    display: flex;
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    padding: 24px 28px;
    background:
      radial-gradient(ellipse at 50% 48%, rgba(231, 160, 169, .2), transparent 46%),
      linear-gradient(145deg, #302226, #151315 72%);
  }

  .seo-art::before,
  .seo-art::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 220px;
    aspect-ratio: 1;
    border: 1px solid rgba(231, 160, 169, .22);
    border-radius: 50%;
    content: "";
    transform: translate(-50%, -50%);
    animation: seo-orbit 18s linear infinite;
  }

  .seo-art::after {
    width: 280px;
    border-color: rgba(231, 160, 169, .12);
    animation-direction: reverse;
    animation-duration: 26s;
  }

  .seo-art-top,
  .seo-art-bottom {
    z-index: 1;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: rgba(248, 232, 234, .55);
    font-size: .58rem;
    letter-spacing: .16em;
  }

  .seo-brand {
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 10px;
  }

  .seo-mark {
    position: relative;
    width: 72px;
    height: 72px;
    border: 1px solid rgba(231, 160, 169, .8);
    border-radius: 50%;
    animation: seo-float 5s ease-in-out infinite;
  }

  .seo-mark-ring {
    position: absolute;
    inset: 11px;
    border: 1px solid rgba(231, 160, 169, .65);
    border-radius: 50%;
  }

  .seo-mark-dot {
    position: absolute;
    top: 14px;
    right: 13px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #f3c2c8;
    box-shadow: 0 0 18px rgba(243, 194, 200, .7);
  }

  .seo-mark-line {
    position: absolute;
    right: 10px;
    bottom: 13px;
    width: 29px;
    height: 1px;
    background: #e7a0a9;
    transform: rotate(-48deg);
    transform-origin: right center;
  }

  .seo-word {
    color: #f8e8ea;
    font-family: var(--font-display);
    font-size: 1.12rem;
    font-weight: 650;
    letter-spacing: .13em;
  }

  .seo-word i {
    color: #e7a0a9;
    font-style: normal;
    font-weight: 400;
  }

  .seo-caption {
    color: #e7a0a9;
    font-size: .55rem;
    letter-spacing: .16em;
    text-align: center;
  }

  @keyframes seo-orbit {
    from { transform: translate(-50%, -50%) rotate(0deg); }
    to { transform: translate(-50%, -50%) rotate(360deg); }
  }

  @keyframes seo-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }

  .arcana-art {
    position: relative;
    display: flex;
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    padding: 24px 28px;
    background:
      radial-gradient(ellipse at 50% 48%, rgba(213, 168, 78, .17), transparent 46%),
      linear-gradient(145deg, #24221b, #111312 72%);
  }

  .arcana-art::before,
  .arcana-art::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 220px;
    aspect-ratio: 1;
    border: 1px solid rgba(213, 168, 78, .2);
    border-radius: 50%;
    content: "";
    transform: translate(-50%, -50%);
  }

  .arcana-art::after {
    width: 280px;
    border-color: rgba(213, 168, 78, .1);
  }

  .arcana-art-top,
  .arcana-art-bottom {
    z-index: 1;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: rgba(240, 233, 217, .52);
    font-size: .58rem;
    letter-spacing: .16em;
  }

  .arcana-brand {
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 10px;
  }

  .arcana-brand img {
    width: 76px;
    height: 76px;
    filter: drop-shadow(0 8px 24px rgba(213, 168, 78, .2));
  }

  .arcana-word {
    color: #f0e9d9;
    font-family: var(--font-display);
    font-size: 1.12rem;
    font-weight: 650;
    letter-spacing: .28em;
    text-indent: .28em;
  }

  .arcana-caption {
    color: #c6a15a;
    font-size: .58rem;
    letter-spacing: .2em;
  }

  .project-content { padding: 26px 26px 28px; }
  .project-eyebrow {
    margin: 0 0 12px;
    color: var(--color-accent);
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .project-content h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.7rem;
    letter-spacing: -.05em;
  }

  .project-description {
    min-height: 106px;
    margin: 14px 0 20px;
    color: var(--color-muted);
    font-size: .9rem;
    line-height: 1.75;
  }

  .project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-stack li {
    padding: 7px 10px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text);
    font-size: .68rem;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 24px;
    color: var(--color-accent);
    font-size: .82rem;
    font-weight: 650;
    text-decoration: none;
  }

  .project-link span { font-size: 1rem; }

  @media (max-width: 800px) {
    .project-heading { gap: 28px; }
    .project-grid { gap: 12px; }
    .project-content { padding: 22px 20px 24px; }
    .project-description { min-height: 132px; }
  }

  @media (max-width: 600px) {
    .project-showcase { padding-block: 62px 76px; }
    .project-heading { grid-template-columns: 1fr; gap: 18px; margin-bottom: 26px; }
    .project-heading h2 { font-size: clamp(2.6rem, 12vw, 3.6rem); }
    .project-grid { grid-template-columns: 1fr; gap: 14px; }
    .project-visual { height: 250px; }
    .project-description { min-height: 0; }
    .arcana-art,
    .seo-art { padding: 20px 18px; }
    .arcana-brand img { width: 68px; height: 68px; }
    .arcana-art-bottom,
    .seo-art-bottom { font-size: .5rem; }
    .seo-mark { width: 64px; height: 64px; }
    .seo-word { font-size: 1rem; }
    .seo-caption { font-size: .48rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-visual > img { transition: none; }
    .seo-art::before,
    .seo-art::after,
    .seo-mark { animation: none; }
  }
</style>
