---
import ProjectCard from "@/components/projects/ProjectCard.astro";
import { projects } from "@/data/projects";
---

<section id="projects" class="project-showcase" aria-labelledby="projects-title">
  <div class="project-heading">
    <div>
      <p class="redesign-kicker">Projectes seleccionats</p>
      <h2 id="projects-title">Idees que es<br /><em>converteixen en producte.</em></h2>
    </div>
    <p class="project-heading-copy">
      Projectes propis i col·laboracions on el desenvolupament, el criteri tècnic
      i l'experiència d'usuari van de la mà.
    </p>
  </div>

  <div class="project-grid">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
</section>

<style>
  .project-showcase {
    padding-block: 88px 104px;
    border-top: 1px solid var(--color-border);
  }
  .project-heading {
    display: grid;
    grid-template-columns: 1fr .8fr;
    gap: 60px;
    align-items: end;
    margin-bottom: 38px;
  }
  .project-heading h2 {
    margin: 18px 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.7rem, 5vw, 4.2rem);
    letter-spacing: -.075em;
    line-height: 1.04;
  }
  .project-heading h2 em {
    color: var(--color-accent);
    font-style: normal;
  }
  .project-heading-copy {
    max-width: 460px;
    margin: 0 0 5px;
    color: var(--color-muted);
    font-size: .96rem;
    line-height: 1.8;
  }
  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }
  @media (max-width: 800px) {
    .project-heading { gap: 28px; }
    .project-grid { gap: 12px; }
  }
  @media (max-width: 600px) {
    .project-showcase { padding-block: 62px 76px; }
    .project-heading { grid-template-columns: 1fr; gap: 18px; margin-bottom: 26px; }
    .project-heading h2 { font-size: clamp(2.6rem, 12vw, 3.6rem); }
    .project-grid { grid-template-columns: 1fr; gap: 14px; }
  }
</style>
