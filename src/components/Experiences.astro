---
import type { LocaleData } from "@/types/types";
import H2 from "./common/H2.astro";

interface Props {
  data: LocaleData;
}
const { data } = Astro.props;
const experience = data.experience;
---

<section id="skills" class="pt-8">
  <H2> {experience.title} </H2>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {
      experience.experiences.map((exp) => (
        <article class="glass-card rounded-2xl border border-slate-700 p-5 shadow-xl">
          <h3 class="text-2xl text-orange-400 font-bold mb-3">{exp.name}</h3>
          <ul class="list-disc list-inside text-slate-200 space-y-2">
            {exp.text.map((line: string) => (
              <li set:html={line} />
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>
