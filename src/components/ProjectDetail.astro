---
import type { projectDetails } from "@/types/types";

interface Props {
  project: projectDetails;
}

const { project } = Astro.props;
---

<article class="glass-card rounded-2xl border border-slate-700 shadow-xl shadow-black/50 overflow-hidden transition duration-300 hover:-translate-y-1 hover:shadow-2xl">
  <a href={project.webLink} target="_blank" rel="noopener noreferrer" class="block">
    <div class="relative overflow-hidden">
      <picture>
        <source type="image/webp" srcset={project.imgSrc} />
        <source type="image/png" srcset={project.imgSrcFallback || project.imgSrc} />
        <img
          src={project.imgSrcFallback || project.imgSrc}
          alt={project.imgName}
          loading="lazy"
          class="w-full h-52 object-cover transition-transform duration-500 hover:scale-105"
        />
      </picture>
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-slate-950/30 to-transparent" />
      <div class="absolute bottom-3 left-3 right-3 text-xs text-slate-100 flex justify-between items-center">
        <span class="px-2 py-1 rounded-full bg-orange-500/90 font-semibold">{project.status || 'WIP'}</span>
        <span class="px-2 py-1 rounded-full bg-blue-500/80">{project.category || 'General'}</span>
      </div>
    </div>
  </a>

  <div class="p-4">
    <h3 class="text-xl text-slate-100 font-bold mb-2">{project.imgName}</h3>
    <p class="text-slate-300 text-sm leading-relaxed" set:html={project.text} />

    {project.stack &&
      <div class="mt-3 flex flex-wrap gap-2">{
        project.stack.map((tech: string) => (
          <span class="rounded-full bg-slate-800 px-2 py-1 text-xs text-slate-200">{tech}</span>
        ))
      }</div>
    }

    <div class="mt-4 flex gap-2">
      <a
        href={project.webLink}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-lg bg-gradient-to-r from-blue-500 to-cyan-500 px-4 py-2 text-sm font-semibold text-white transition hover:brightness-110"
      >
        Ver projecte
      </a>
      <a
        href={project.codeLink || project.webLink}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-lg border border-slate-500 bg-transparent px-4 py-2 text-sm font-medium text-slate-100 transition hover:bg-slate-700"
      >
        Codi
      </a>
    </div>
  </div>
</article>
