---
interface Props {
  href?: string;
}

const { href = "/preview" } = Astro.props;
---

<a class="brand-logo" href={href} aria-label="Xavier Rabert — inici">
  <img
    class="brand-lockup"
    src="/brand/xr-lockup.svg"
    alt="Xavier Rabert"
    width="700"
    height="180"
    fetchpriority="high"
  />
</a>

<style>
  .brand-lockup {
    display: block;
    width: clamp(210px, 23vw, 270px);
    height: auto;
    flex: 0 0 auto;
  }

  @media (max-width: 600px) {
    .brand-lockup {
      width: 190px;
    }
  }
</style>
