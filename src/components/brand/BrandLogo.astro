---

interface Props {
  href?: string;
}

const { href = "/preview" } = Astro.props;
---

<a class="brand-logo" href={href} aria-label="Xavier Rabert — inici">
  <svg
    class="brand-mark-svg"
    viewBox="0 0 100 60"
    role="img"
    aria-label="XR"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      d="M3 5H20L40 27L60 5H77L49 31L77 55H59L40 37L20 55H3L31 31L3 5Z"
      fill="#F0F0EC"
    />
    <path
      d="M49 5H75C92 5 96 28 80 35L98 55H78L61 36H49V55H33L49 31V5ZM65 18V25H74C79 25 79 18 74 18H65Z"
      fill="#C2F970"
      fill-rule="evenodd"
    />
  </svg>
  <span class="brand-name">Xavier<br />Rabert</span>
</a>

<style>
  .brand-mark-svg {
    display: block;
    width: 84px;
    height: 51px;
    flex: 0 0 auto;
    overflow: visible;
  }

  @media (max-width: 600px) {
    .brand-mark-svg {
      width: 72px;
      height: 44px;
    }
  }
</style>
