---
import type { Project } from "@/data/projects";
import ArcanaVisual from "./visuals/ArcanaVisual.astro";
import SeoVisual from "./visuals/SeoVisual.astro";
import SpaceXVisual from "./visuals/SpaceXVisual.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article
  class:list={["project-card", `project-card--${project.kind}`]}
  style={`--project-accent: ${project.accent}; --project-accent-soft: ${project.accentSoft}; --project-tag-text: ${project.tagText};`}
>
  <div class="project-visual">
    {project.kind === "arcana" ? (
      <ArcanaVisual />
    ) : project.kind === "seo" ? (
      <SeoVisual />
    ) : (
      <SpaceXVisual />
    )}
    <span class="project-number">{project.number}</span>
  </div>

  <div class="project-content">
    <p class="project-eyebrow">{project.eyebrow}</p>
    <h3>{project.name}</h3>
    <p class="project-description">{project.description}</p>
    <ul class="project-stack" aria-label="Tecnologies">
      {project.stack.map((technology) => <li>{technology}</li>)}
    </ul>
    <a class="project-link" href={project.href} target="_blank" rel="noopener noreferrer">
      Visitar el projecte <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>

<style>
  .project-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: var(--color-surface);
  }

  .project-visual {
    position: relative;
    height: clamp(220px, 27vw, 340px);
    overflow: hidden;
    background: #171c1c;
  }

  .project-number {
    position: absolute;
    top: 16px;
    right: 16px;
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border: 1px solid rgba(240, 240, 236, .24);
    border-radius: 50%;
    background: rgba(17, 19, 21, .72);
    color: var(--color-text);
    font-size: .68rem;
    backdrop-filter: blur(8px);
  }

  .project-content { padding: 26px 26px 28px; }
  .project-eyebrow {
    margin: 0 0 12px;
    color: var(--project-accent);
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .13em;
    text-transform: uppercase;
  }
  .project-content h3 {
    margin: 0;
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.7rem;
    letter-spacing: -.05em;
  }
  .project-description {
    min-height: 106px;
    margin: 14px 0 20px;
    color: rgba(235, 240, 244, .68);
    font-size: .9rem;
    line-height: 1.75;
  }
  .project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .project-stack li {
    padding: 7px 10px;
    border: 1px solid var(--project-accent-soft);
    border-radius: 999px;
    background: color-mix(in srgb, var(--project-accent) 4.5%, transparent);
    color: var(--project-tag-text);
    font-size: .68rem;
  }
  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 24px;
    color: var(--project-accent);
    font-size: .82rem;
    font-weight: 650;
    text-decoration: none;
  }
  .project-link span { font-size: 1rem; }

  @media (max-width: 800px) {
    .project-content { padding: 22px 20px 24px; }
    .project-description { min-height: 132px; }
  }
  @media (max-width: 600px) {
    .project-visual { height: 250px; }
    .project-description { min-height: 0; }
  }
</style>
