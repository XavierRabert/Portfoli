---
import Layout from "@/layouts/Layout.astro";
import Main from "@/components/Main.astro";
import Experiences from "@/components/Experiences.astro";
import Projects from "@/components/Projects.astro";
import About from "@/components/About.astro";
import GoUp from "@/components/common/GoUp.astro";
import { getData } from "@/lib/i18n";
const currentLocale = Astro.currentLocale || "ca";
const data = getData(currentLocale);
---

<Layout title="Xavier Rabert">
  <Main data={data} />
  <main class="flex flex-col space-y-10 px-6 lg:px-60 xl:px-96">
    <Experiences data={data} />
    <Projects data={data} />
    <About data={data} />
    <GoUp />
  </main>
</Layout>
