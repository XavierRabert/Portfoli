---
import RedesignLayout from "@/layouts/RedesignLayout.astro";
import BrandLogo from "@/components/brand/BrandLogo.astro";
import ProjectShowcase from "@/components/ProjectShowcase.astro";
import AboutSection from "@/components/redesign/AboutSection.astro";
import ExpertiseSection from "@/components/redesign/ExpertiseSection.astro";
---

<RedesignLayout
  title="Xavier Rabert — Frontend Engineer"
  description="Portfolio de Xavier Rabert. Desenvolupament frontend, Angular i experiències digitals."
>
  <div class="redesign-shell">
    <header class="site-header">
      <BrandLogo />
      <nav class="desktop-nav" aria-label="Navegació principal">
        <a href="#projects">Projectes</a>
        <a href="#about">Sobre mi</a>
        <a href="#expertise">Especialització</a>
        <a href="#contact">Contacte</a>
        <div class="header-socials" aria-label="Xarxes socials">
          <a href="https://github.com/XavierRabert" target="_blank" rel="noopener noreferrer" aria-label="GitHub (s'obre en una pestanya nova)">
