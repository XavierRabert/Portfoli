          </a>
          <a href="https://www.linkedin.com/in/xavierrabert/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (s'obre en una pestanya nova)">
            <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M0 2.5911v14.8512c0 1.4018 1.1031 2.5049 2.5049 2.5049h14.8512c.6861 0 1.3417-.3283 1.7597-.7453.4475-.4475.7453-1.0144.7453-1.7597v-14.8512c0-1.4018-1.1031-2.5049-2.5049-2.5049h-14.8512c-.7453 0-1.3121.2987-1.7597.7453-.418.418-.7453 1.0735-.7453 1.7597zM2.6843 4.5587c0-.9543.7758-1.7892 1.7301-1.7892.9838 0 1.7892.835 1.7892 1.7892 0 .9838-.8054 1.7597-1.7892 1.7597-.9543 0-1.7301-.7758-1.7301-1.7597zM7.4852 16.8153v-9.0951c0-.209.209-.3874.3578-.3874h2.5345c.3578 0 .3578.418.3578.6861.7157-.7157 1.6404-.8951 2.5946-.8951 2.3265 0 3.817 1.1031 3.817 3.5489v6.1435c0 .209-.1794.3874-.3578.3874h-2.6242c-.209 0-.3578-.209-.3578-.3874v-5.5471c0-.9247-.2681-1.4314-1.3121-1.4314-1.3121 0-1.6404.8646-1.6404 2.0278v4.9507c0 .209-.209.3874-.418.3874h-2.5946c-.1489 0-.3578-.209-.3578-.3874zM2.7435 16.8153v-9.0951c0-.209.209-.3874.3578-.3874h2.5946c.2386 0 .3874.1489.3874.3874v9.0951c0 .209-.1794.3874-.3874.3874h-2.5946c-.1794 0-.3578-.209-.3578-.3874z"/></svg>
          </a>
        </div>
        <div class="language-switch" aria-label="Idioma">
          <a class="is-active" href="/preview" lang="ca" aria-current="page">CA</a>
          <a href="/es/" lang="es">ES</a>
        </div>
      </nav>
      <details class="mobile-menu">
        <summary aria-label="Obrir menú de navegació">
          <span></span><span></span>
        </summary>
        <nav aria-label="Navegació mòbil">
          <a href="#projects">Projectes</a>
          <a href="#about">Sobre mi</a>
          <a href="#expertise">Especialització</a>
          <a href="#contact">Contacte</a>
          <div class="header-socials" aria-label="Xarxes socials">
            <a href="https://github.com/XavierRabert" target="_blank" rel="noopener noreferrer" aria-label="GitHub (s'obre en una pestanya nova)">
