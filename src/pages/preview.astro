---
import RedesignLayout from "@/layouts/RedesignLayout.astro";
import BrandLogo from "@/components/brand/BrandLogo.astro";
---

<RedesignLayout
  title="Xavier Rabert — Frontend Engineer"
  description="Portfolio de Xavier Rabert. Desenvolupament frontend, Angular i experiències digitals."
>
  <div class="redesign-shell">
    <header class="site-header">
      <BrandLogo />
      <nav class="desktop-nav" aria-label="Navegació principal">
        <a href="#work">Projectes</a>
        <a href="#about">Sobre mi</a>
        <a href="#contact">Contacte</a>
        <div class="language-switch" aria-label="Idioma">
          <a class="is-active" href="/preview" lang="ca" aria-current="page">CA</a>
          <a href="/es/" lang="es">ES</a>
        </div>
      </nav>
      <details class="mobile-menu">
        <summary aria-label="Obrir menú de navegació">
          <span></span><span></span>
        </summary>
        <nav aria-label="Navegació mòbil">
          <a href="#work">Projectes</a>
          <a href="#about">Sobre mi</a>
          <a href="#contact">Contacte</a>
          <div class="language-switch">
            <a class="is-active" href="/preview" lang="ca" aria-current="page">CA</a>
            <a href="/es/" lang="es">ES</a>
          </div>
        </nav>
      </details>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="redesign-kicker">Frontend engineer <span>·</span> Angular</p>
          <h1 id="hero-title">Hola, soc<br />en Xavier<span class="hero-period">.</span></h1>
          <p class="hero-lead">
            Dissenyo i construeixo <em>experiències digitals</em> amb codi net,
            criteri i atenció pels detalls.
          </p>
          <p class="hero-support">
            Un espai per descobrir els projectes que faig i les idees que m'agrada explorar.
          </p>
          <div class="hero-actions">
            <a class="redesign-link redesign-link--primary" href="#work">
              Veure projectes <span aria-hidden="true">↗</span>
            </a>
            <a class="text-link" href="#contact">Parlem-ne <span aria-hidden="true">→</span></a>
          </div>
          <p class="hero-note"><span aria-hidden="true"></span> Treballant des de Catalunya</p>
        </div>

        <div class="portrait-placeholder" role="img" aria-label="Espai reservat per a una fotografia de Xavier">
          <div class="portrait-frame">
            <span class="portrait-corner portrait-corner--top"></span>
            <span class="portrait-monogram" aria-hidden="true">XR</span>
            <span class="portrait-caption">La foto bona està en camí ;)</span>
            <span class="portrait-index">01 / INTRO</span>
            <span class="portrait-corner portrait-corner--bottom"></span>
          </div>
          <span class="portrait-orbit" aria-hidden="true"></span>
        </div>
      </section>

      <section id="work" class="intro-section" aria-labelledby="work-title">
        <div>
          <p class="redesign-kicker">Una mica del que faig</p>
          <h2 id="work-title">Tecnologia amb<br /><em>intenció.</em></h2>
        </div>
        <p class="intro-copy">
          M'agrada entendre els problemes, trobar solucions clares i convertir-les
          en productes digitals útils. Aquí és on anirem descobrint alguns dels meus projectes.
        </p>
      </section>

      <section id="about" class="principles" aria-label="Principis de treball">
        <article><span>01</span><h3>Bon criteri tècnic</h3><p>Arquitectura clara, codi mantenible i decisions amb sentit.</p></article>
        <article><span>02</span><h3>Experiència d'usuari</h3><p>Interfícies cuidades, accessibles i agradables d'utilitzar.</p></article>
        <article><span>03</span><h3>Aprendre construint</h3><p>Experimentar, prototipar i fer que les idees passin coses.</p></article>
      </section>
    </main>

    <footer id="contact" class="site-footer">
      <p>Hi ha alguna cosa interessant entre mans?</p>
      <a href="mailto:xrabert@gmail.com">Parlem-ne <span aria-hidden="true">↗</span></a>
      <small>© {new Date().getFullYear()} Xavier Rabert</small>
    </footer>
  </div>
</RedesignLayout>
