              <span>GitHub</span>
            </a>
            <a href="https://www.linkedin.com/in/xavierrabert/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (s'obre en una pestanya nova)">
              <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M0 2.5911v14.8512c0 1.4018 1.1031 2.5049 2.5049 2.5049h14.8512c.6861 0 1.3417-.3283 1.7597-.7453.4475-.4475.7453-1.0144.7453-1.7597v-14.8512c0-1.4018-1.1031-2.5049-2.5049-2.5049h-14.8512c-.7453 0-1.3121.2987-1.7597.7453-.418.418-.7453 1.0735-.7453 1.7597zM2.6843 4.5587c0-.9543.7758-1.7892 1.7301-1.7892.9838 0 1.7892.835 1.7892 1.7892 0 .9838-.8054 1.7597-1.7892 1.7597-.9543 0-1.7301-.7758-1.7301-1.7597zM7.4852 16.8153v-9.0951c0-.209.209-.3874.3578-.3874h2.5345c.3578 0 .3578.418.3578.6861.7157-.7157 1.6404-.8951 2.5946-.8951 2.3265 0 3.817 1.1031 3.817 3.5489v6.1435c0 .209-.1794.3874-.3578.3874h-2.6242c-.209 0-.3578-.209-.3578-.3874v-5.5471c0-.9247-.2681-1.4314-1.3121-1.4314-1.3121 0-1.6404.8646-1.6404 2.0278v4.9507c0 .209-.209.3874-.418.3874h-2.5946c-.1489 0-.3578-.209-.3578-.3874zM2.7435 16.8153v-9.0951c0-.209.209-.3874.3578-.3874h2.5946c.2386 0 .3874.1489.3874.3874v9.0951c0 .209-.1794.3874-.3874.3874h-2.5946c-.1794 0-.3578-.209-.3578-.3874z"/></svg>
              <span>LinkedIn</span>
            </a>
          </div>
          <div class="language-switch">
            <a class="is-active" href="/preview" lang="ca" aria-current="page">CA</a>
            <a href="/es/" lang="es">ES</a>
          </div>
        </nav>
      </details>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="redesign-kicker">Frontend developer</p>
          <h1 id="hero-title">Xavier<br /><span class="hero-name-accent">Rabert</span></h1>
          <p class="hero-lead">
            Construeixo experiències digitals amb codi net i bon disseny.
          </p>
          <div class="hero-actions">
            <a class="text-link hero-work-link" href="#projects">
              Veure projectes <span aria-hidden="true">→</span>
            </a>
          </div>
          <p class="hero-note"><span aria-hidden="true"></span> Treballant des de Catalunya</p>
        </div>

        <div class="portrait-placeholder" role="img" aria-label="Espai reservat per a una fotografia de Xavier">
          <div class="portrait-frame">
            <span class="portrait-corner portrait-corner--top"></span>
            <span class="portrait-monogram" aria-hidden="true">XR</span>
            <span class="portrait-caption">La foto bona està en camí ;)</span>
            <span class="portrait-index">01 / INTRO</span>
            <span class="portrait-corner portrait-corner--bottom"></span>
          </div>
          <span class="portrait-orbit" aria-hidden="true"></span>
        </div>
      </section>

      <section id="work" class="intro-section" aria-labelledby="work-title">
        <div>
          <p class="redesign-kicker">Una mica del que faig</p>
          <h2 id="work-title">Tecnologia amb<br /><em>intenció.</em></h2>
        </div>
        <p class="intro-copy">
          M'agrada entendre els problemes, trobar solucions clares i convertir-les
          en productes digitals útils. Aquests són alguns projectes on he pogut
          portar les idees a la pràctica.
        </p>
      </section>

      <ProjectShowcase />

      <AboutSection />
      <ExpertiseSection />
    </main>

    <footer id="contact" class="site-footer">
      <div class="footer-copy">
        <p>Hi ha alguna cosa interessant entre mans?</p>
        <small>© {new Date().getFullYear()} Xavier Rabert</small>
      </div>
      <div class="footer-contact">
        <a class="footer-email" href="mailto:xrabert@gmail.com">
          xrabert@gmail.com <span aria-hidden="true">↗</span>
        </a>
        <div class="footer-socials" aria-label="També em pots trobar a">
          <a href="https://github.com/XavierRabert" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="m10 0c5.523 0 10 4.59 10 10.253 0 4.529-2.862 8.371-6.833 9.728-.507.101-.687-.219-.687-.492 0-.338.012-1.442.012-2.814 0-.956-.32-1.58-.679-1.898 2.227-.254 4.567-1.121 4.567-5.059 0-1.12-.388-2.034-1.03-2.752.104-.259.447-1.302-.098-2.714 0 0-.838-.275-2.747 1.051-.799-.227-1.655-.341-2.505-.345-.85.004-1.705.118-2.503.345-1.911-1.326-2.751-1.051-2.751-1.051-.543 1.412-.2 2.455-.097 2.714-.639.718-1.03 1.632-1.03 2.752 0 3.928 2.335 4.808 4.556 5.067-.286.256-.545.708-.635 1.371-.57.262-2.018.715-2.91-.852 0 0-.529-.985-1.533-1.057 0 0-.975-.013-.068.623 0 0 .655.315 1.11 1.5 0 0 .587 1.83 3.369 1.21.005.857.014 1.665.014 1.909 0 .271-.184.588-.683.493-3.974-1.355-6.839-5.199-6.839-9.729 0-5.663 4.478-10.253 10-10.253"/></svg>
            GitHub <span aria-hidden="true">↗</span>
          </a>
          <a href="https://www.linkedin.com/in/xavierrabert/" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M0 2.5911v14.8512c0 1.4018 1.1031 2.5049 2.5049 2.5049h14.8512c.6861 0 1.3417-.3283 1.7597-.7453.4475-.4475.7453-1.0144.7453-1.7597v-14.8512c0-1.4018-1.1031-2.5049-2.5049-2.5049h-14.8512c-.7453 0-1.3121.2987-1.7597.7453-.418.418-.7453 1.0735-.7453 1.7597zM2.6843 4.5587c0-.9543.7758-1.7892 1.7301-1.7892.9838 0 1.7892.835 1.7892 1.7892 0 .9838-.8054 1.7597-1.7892 1.7597-.9543 0-1.7301-.7758-1.7301-1.7597zM7.4852 16.8153v-9.0951c0-.209.209-.3874.3578-.3874h2.5345c.3578 0 .3578.418.3578.6861.7157-.7157 1.6404-.8951 2.5946-.8951 2.3265 0 3.817 1.1031 3.817 3.5489v6.1435c0 .209-.1794.3874-.3578.3874h-2.6242c-.209 0-.3578-.209-.3578-.3874v-5.5471c0-.9247-.2681-1.4314-1.3121-1.4314-1.3121 0-1.6404.8646-1.6404 2.0278v4.9507c0 .209-.209.3874-.418.3874h-2.5946c-.1489 0-.3578-.209-.3578-.3874zM2.7435 16.8153v-9.0951c0-.209.209-.3874.3578-.3874h2.5946c.2386 0 .3874.1489.3874.3874v9.0951c0 .209-.1794.3874-.3874.3874h-2.5946c-.1794 0-.3578-.209-.3578-.3874z"/></svg>
            LinkedIn <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </footer>
  </div>
</RedesignLayout>

<style>
  .hero-name-accent {
    color: var(--color-accent);
  }

  .hero-work-link {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--color-accent);
    color: var(--color-text);
    font-weight: 650;
  }

  .hero-work-link span {
    color: var(--color-accent);
    font-size: 1.2rem;
  }
</style>
